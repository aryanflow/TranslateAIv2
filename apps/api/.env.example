# Copy to `.env` in this folder (`apps/api/.env`). Matches docker-compose.yaml defaults.

# Optional: surfaced by GET /version (set in CI / Docker build-args instead of .env when possible)
# GIT_SHA=
# BUILD_TIME=
# GIT_COMMIT_MESSAGE=

PORT=3001

DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/aptos_translate
REDIS_URL=redis://127.0.0.1:6379

# MinIO (start with: docker compose --profile full up -d minio)
S3_REGION=us-east-1
S3_BUCKET=aptos-translate-uploads
S3_ENDPOINT=http://127.0.0.1:9000
S3_ACCESS_KEY_ID=minio
S3_SECRET_ACCESS_KEY=minio12345
S3_FORCE_PATH_STYLE=true

# Langdock / LLM (required for real translations when using Langdock paths)
# Prefer LANGDOCK_BEARER_TOKEN; LANGDOCK_API_KEY is an accepted alias.
# LANGDOCK_BEARER_TOKEN=
# LANGDOCK_API_KEY=
# LANGDOCK_REGION=us
# LANGDOCK_API_TIMEOUT=120
# LANGDOCK_MODEL=gpt-5.2
# LANGDOCK_TRANSLATION_MODEL=
# GEMINI_MODEL=gemini-2.0-flash
# MAX_RETRIES=3
# GOOGLE_GEMINI_API_KEY=
