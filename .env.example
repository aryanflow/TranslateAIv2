# — Web (Next.js) —
NEXT_PUBLIC_API_URL=http://127.0.0.1:3001
# Dev only: must match a row in `Tenant` (run: pnpm --filter api run db:seed)
NEXT_PUBLIC_DEV_TENANT_ID=00000000-0000-4000-8000-000000000001
# Optional: for `pnpm --filter web run generate:api`
OPENAPI_URL=http://127.0.0.1:3001/api/docs-json

# — API (NestJS) —
PORT=3001
# PostgreSQL 16: use `docker compose up -d postgres` in repo root, then:
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/aptos_translate
# Job queue (BullMQ) — not wired in scaffold yet
REDIS_URL=redis://127.0.0.1:6379
# S3-compatible storage (AWS S3 or MinIO — see docker-compose `minio` service + profile `full`)
S3_REGION=us-east-1
S3_BUCKET=aptos-translate-uploads
# For MinIO local: http://127.0.0.1:9000 with keys below
# S3_ENDPOINT=http://127.0.0.1:9000
# S3_ACCESS_KEY_ID=minio
# S3_SECRET_ACCESS_KEY=minio12345
# S3_FORCE_PATH_STYLE=true
# LLM (never expose to browser). Prefer LANGDOCK_BEARER_TOKEN; LANGDOCK_API_KEY is an alias.
GOOGLE_GEMINI_API_KEY=
LANGDOCK_BEARER_TOKEN=
# LANGDOCK_API_KEY=
# LANGDOCK_REGION=us
# Timeout for Langdock HTTP calls (seconds)
# LANGDOCK_API_TIMEOUT=120
# OpenAI-compatible model on Langdock (translation when tenant uses langdock translator)
# LANGDOCK_MODEL=gpt-5.2
# LANGDOCK_TRANSLATION_MODEL=
# Model id for Gemini *via Langdock Google API* (scoring / gemini translator path)
# GEMINI_MODEL=gemini-2.0-flash
# Retries for Langdock OpenAI translate/chat
# MAX_RETRIES=3
# OpenTelemetry (optional)
# OTEL_EXPORTER_OTLP_ENDPOINT=
