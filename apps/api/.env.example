# Copy to `.env` in this folder (`apps/api/.env`). Matches docker-compose.yaml defaults.
PORT=3001

# OpenAPI: UI at /api/docs, JSON at /api/openapi.json. On by default in dev; in production
# (NODE_ENV=production) set to true to expose Swagger (e.g. internal staging only).
# SWAGGER_ENABLED=true

DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/aptos_translate
REDIS_URL=redis://127.0.0.1:6379

# MinIO (start with: docker compose --profile full up -d minio)
S3_REGION=us-east-1
S3_BUCKET=aptos-translate-uploads
S3_ENDPOINT=http://127.0.0.1:9000
S3_ACCESS_KEY_ID=minio
S3_SECRET_ACCESS_KEY=minio12345
S3_FORCE_PATH_STYLE=true

# — Amazon Bedrock (translation + scoring via Converse API) —
# Enable each provider in the Bedrock console (Model access) for your account/region.
# Inference profile ARNs are also valid instead of foundation model ids.
# https://docs.aws.amazon.com/bedrock/latest/userguide/model-cards.html
#
# Default pairing (see apps/api/src/config/bedrock-defaults.ts):
# - Translation: Google Gemma 3 12B IT — strong batch UI translation on Bedrock.
# - Quality reviewer / judge: OpenAI GPT-OSS **20B** — fewer empty short responses than 120B on some accounts.
#   Prefer `openai.gpt-oss-120b-1:0` when your Bedrock tenant streams it reliably.
AWS_REGION=us-east-1
BEDROCK_TRANSLATION_MODEL_ID=google.gemma-3-12b-it
BEDROCK_SCORING_MODEL_ID=openai.gpt-oss-20b-1:0
# Alternate judge size / translator tiers:
# BEDROCK_TRANSLATION_MODEL_ID=google.gemma-3-4b-it
# BEDROCK_SCORING_MODEL_ID=openai.gpt-oss-120b-1:0

# Optional overlays (prepend to system prompts):
# BEDROCK_TRANSLATOR_SYSTEM_OVERLAY=
# BEDROCK_SCORER_SYSTEM_OVERLAY=

# Parallel translate+score batches per target language (1–24, default 8). Higher = faster
# when Bedrock quota allows; lower if you see ThrottlingException in logs.
# TRANSLATION_BATCH_CONCURRENCY=8

# BEDROCK_MODEL_ID=   # alias for BEDROCK_TRANSLATION_MODEL_ID only
# BEDROCK_TRANSLATION_MAX_TOKENS=8192
# BEDROCK_TRANSLATION_TEMPERATURE=0.15
# BEDROCK_SCORING_MAX_TOKENS=8192
# BEDROCK_SCORING_TEMPERATURE=0.15
# MAX_RETRIES=3
