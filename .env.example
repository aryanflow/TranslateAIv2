# — Web (Next.js) —
NEXT_PUBLIC_API_URL=http://127.0.0.1:3001
# Preferred: server-side origin for the Next.js `/api/upstream/*` proxy (see apps/web/src/app/api/upstream/[...path]/route.ts). ECS can set this to the internal API URL.
API_PROXY_TARGET=http://127.0.0.1:3001
NEXT_PUBLIC_DEV_TENANT_ID=00000000-0000-4000-8000-000000000001
# Optional: for `pnpm --filter web run generate:api`
OPENAPI_URL=http://127.0.0.1:3001/api/docs-json

# — API (NestJS) —
PORT=3001
# PostgreSQL 16: use `docker compose up -d postgres` in repo root, then:
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/aptos_translate
REDIS_URL=redis://127.0.0.1:6379
# S3-compatible storage (AWS S3 or MinIO — see docker-compose `minio` service + profile `full`)
S3_REGION=us-east-1
S3_BUCKET=aptos-translate-uploads
# For MinIO local: http://127.0.0.1:9000 with keys below
# S3_ENDPOINT=http://127.0.0.1:9000
# S3_ACCESS_KEY_ID=minio
# S3_SECRET_ACCESS_KEY=minio12345
# S3_FORCE_PATH_STYLE=true

# — Amazon Bedrock (server-side only; never expose keys to the browser) —
AWS_REGION=us-east-1
# Gemma (translate) + GPT-OSS reviewer — see apps/api/src/config/bedrock-defaults.ts
BEDROCK_TRANSLATION_MODEL_ID=google.gemma-3-12b-it
BEDROCK_SCORING_MODEL_ID=openai.gpt-oss-20b-1:0

# OpenTelemetry (optional)
# OTEL_EXPORTER_OTLP_ENDPOINT=
